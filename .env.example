# OpenAI（この新規プロジェクト専用のキーを発行して使うこと。既存システムとキーを共有しない＝コスト分離）
OPENAI_API_KEY=
# 既定は gpt-realtime-2.1-mini。function callingが不安定な場合は
# gpt-realtime-2.1 / gpt-realtime-1.5 へ切り戻す
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini

# Twilio（新規購入したテスト用電話番号のアカウント情報）
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Railway
RAILWAY_PUBLIC_DOMAIN=
# 録音再生URLの署名鍵（必須。32バイト以上のランダム値を設定すること。
# 例: python -c "import secrets; print(secrets.token_hex(32))"）
RECORDING_LINK_SECRET=

# Salesforce（既存システムと同じ値を流用可）
SF_USERNAME=
SF_PASSWORD=
SF_TOKEN=
SF_DOMAIN=test
SF_CASE_OWNER_ID=
SF_CASE_RECORD_TYPE_ID=

# ログ・通知
GOOGLE_CHAT_WEBHOOK_URL=
RAILWAY_DASHBOARD_URL=

# 管理ダッシュボード(/admin/dashboard)のパスワード。プロンプト編集と
# コスト設定保存のみを保護する（画面・通話ログ・コスト参照は無認証）。
# 未設定だとそれらの保存操作が一切通らなくなる。
ADMIN_PASSWORD=

# ローカル開発時のみ上書き（本番は /data/call_log.db のデフォルトのまま）
CALL_LOG_DB_PATH=./call_log.db

# VAD / タイムアウト チューニング（未設定ならデフォルト値を使用）
VAD_THRESHOLD=0.5
VAD_SPEECH_START_MS=250
VAD_SPEECH_END_MS=500
BARGE_IN_MIN_MS=500
GRACE_AFTER_AI_END_MS=500
SILENCE_TIMEOUT_SEC=10
MAX_CALL_DURATION_SEC=300
RESPONSE_WATCHDOG_FIRST_SEC=5
RESPONSE_WATCHDOG_SECOND_SEC=5

# 応答冒頭の頭切れ対策: 各応答の音声冒頭に挿入する無音(ms)
RESPONSE_LEAD_SILENCE_MS=250

# 即時相槌（オプション機能。比較テスト用に切り替え可能）
ENABLE_FILLER=false
FILLER_AUDIO_PATH=assets/audio/aizuchi_kashikomarimashita.ulaw

# 挨拶の即時再生（事前生成クリップ）とOpenAI接続タイムアウト時の縮退運転
GREETING_AUDIO_PATH=assets/audio/greeting_o_matase.ulaw
OPENAI_CONNECT_TIMEOUT_SEC=5
DEGRADED_AUDIO_PATH=assets/audio/degraded_konzatsu.ulaw

# メディア入力途絶ウォッチドッグ（Twilio→サーバーのフレームが止まる障害の検知）
MEDIA_STARVATION_TIMEOUT_SEC=5.0
ENABLE_MEDIA_STARVATION_WATCHDOG=true

# 切電案内クリップ（無音・最大通話時間用 / 縮退運転用）
SILENCE_GOODBYE_AUDIO_PATH=assets/audio/silence_goodbye.ulaw
ESCALATION_AUDIO_PATH=assets/audio/escalation_kikitorenai.ulaw

# 検証専用: 指定秒数経過後にmediaフレームを捨てて途絶を再現する。本番は必ず0
DEBUG_DROP_MEDIA_AFTER_SEC=0

# 受信フレームレートのログ間隔（秒）。0で無効。再現キャンペーン中は1、
# 終了後は5に上げるか0にする
MEDIA_RATE_LOG_INTERVAL_SEC=1.0
