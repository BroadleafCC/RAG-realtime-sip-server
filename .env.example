# OpenAI（この新規プロジェクト専用のキーを発行して使うこと。既存システムとキーを共有しない＝コスト分離）
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-1.5

# Twilio（新規購入したテスト用電話番号のアカウント情報）
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Railway
RAILWAY_PUBLIC_DOMAIN=
RECORDING_ACCESS_TOKEN=

# Salesforce（既存システムと同じ値を流用可）
SF_USERNAME=
SF_PASSWORD=
SF_TOKEN=
SF_DOMAIN=test
SF_CASE_OWNER_ID=
SF_CASE_RECORD_TYPE_ID=

# ログ・通知
GOOGLE_CHAT_WEBHOOK_URL=
RAILWAY_DASHBOARD_URL=

# ローカル開発時のみ上書き（本番は /data/call_log.db のデフォルトのまま）
CALL_LOG_DB_PATH=./call_log.db

# VAD / タイムアウト チューニング（未設定ならデフォルト値を使用）
VAD_THRESHOLD=0.5
VAD_SPEECH_START_MS=250
VAD_SPEECH_END_MS=650
BARGE_IN_MIN_MS=500
GRACE_AFTER_AI_END_MS=500
SILENCE_TIMEOUT_SEC=10
MAX_CALL_DURATION_SEC=300
RESPONSE_WATCHDOG_FIRST_SEC=5
RESPONSE_WATCHDOG_SECOND_SEC=5
